<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/widget_fg" android:textSize="15sp" android:textStyle="bold" android:text="우리 캘린더" />
    <TextView android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:textColor="@color/widget_fg" android:textSize="13sp" android:lineSpacingExtra="3dp"
        android:ellipsize="end" android:maxLines="4" />
    <TextView android:id="@+id/w_anniv" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/widget_accent" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
